<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="ValidateModDeploymentContract">
    <Import Project=".\local.props" Condition="Exists('.\local.props')"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>true</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <RootNamespace>Vivhite</RootNamespace>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>

        <GodotExportPreset>Windows Desktop</GodotExportPreset>
        <Sts2Dir Condition="'$(Sts2Dir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Slay the Spire 2</Sts2Dir>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
        <ModOutputDir>$(Sts2Dir)\mods\$(MSBuildProjectName)\</ModOutputDir>
        <!-- All three artifacts are produced away from the live Mod directory first. -->
        <ModDeploymentTransactionId Condition="'$(ModDeploymentTransactionId)' == ''">$([System.Guid]::NewGuid().ToString('N'))</ModDeploymentTransactionId>
        <ModCandidateRoot Condition="'$(ModCandidateRoot)' == ''">$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\mod-candidate\$(ModDeploymentTransactionId)\</ModCandidateRoot>
        <ModPckPath Condition="'$(ModPckPath)' == ''">$(ModCandidateRoot)$(MSBuildProjectName).pck</ModPckPath>
        <!-- 本机测试时 RitsuLib 包/构建逻辑会使用这个目录把 RitsuLib 部署到游戏 mods/STS2-RitsuLib。 -->
        <!-- Local test builds use this directory when RitsuLib package/build logic deploys RitsuLib to game mods/STS2-RitsuLib. -->
        <RitsuLibDeployDir Condition="'$(RitsuLibDeployDir)' == ''">$(Sts2Dir)\mods\STS2-RitsuLib</RitsuLibDeployDir>
        <RunPckExport Condition="'$(RunPckExport)' == '' and '$(DesignTimeBuild)' != 'true'">true</RunPckExport>
        <RunPckExport Condition="'$(RunPckExport)' == ''">false</RunPckExport>
        <!-- Keep /p:RunPckExport=false and STS2_SKIP_PCK_EXPORT=1 safe when callers
             omit CopyModOnBuild. An explicit CopyModOnBuild value remains authoritative. -->
        <CopyModOnBuild Condition="'$(CopyModOnBuild)' == '' and ('$(RunPckExport)' == 'false' or '$(STS2_SKIP_PCK_EXPORT)' == '1')">false</CopyModOnBuild>
        <CopyModOnBuild Condition="'$(CopyModOnBuild)' == ''">true</CopyModOnBuild>
        <!-- An offline/no-copy build must not let RitsuLib's transitive package target
             update the live game independently of this Mod's CopyMod target. -->
        <RitsuLibAutoCopy Condition="'$(CopyModOnBuild)' == 'false' and '$(RitsuLibAutoCopy)' == ''">false</RitsuLibAutoCopy>
        <IroncladSkinValidator>$(MSBuildProjectDirectory)\tools\Validate-IroncladSkin.ps1</IroncladSkinValidator>
        <IroncladSkinRuntimeLayout Condition="'$(IroncladSkinRuntimeLayout)' == ''">v3-five-page</IroncladSkinRuntimeLayout>
        <GodotPckExporter>$(MSBuildProjectDirectory)\tools\Export-ModPck.ps1</GodotPckExporter>
        <VivhiteDeploymentFailurePoint Condition="'$(VivhiteDeploymentFailurePoint)' == ''"></VivhiteDeploymentFailurePoint>
        <PowerShellExe Condition="'$(PowerShellExe)' == '' and '$(OS)' == 'Windows_NT'">powershell.exe</PowerShellExe>
        <PowerShellExe Condition="'$(PowerShellExe)' == ''">pwsh</PowerShellExe>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1" PrivateAssets="all"/>
        <!-- Pin the RitsuLib runtime API used by the Ironclad replacement registration. -->
        <PackageReference Include="STS2.RitsuLib" Version="0.5.14" GeneratePathProperty="true"/>
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="0Harmony" HintPath="$(Sts2DataDir)\0Harmony.dll" Private="True"/>
        <Reference Include="sts2" HintPath="$(Sts2DataDir)\sts2.dll" Private="True"/>
        <Reference Include="Steamworks.NET" HintPath="$(Sts2DataDir)\Steamworks.NET.dll" Private="True"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 中文：排除 Godot、IDE 和构建输出目录，避免本地生成文件参与编译。 -->
        <!-- English: Exclude Godot, IDE, and build output directories so local generated files are not compiled. -->
        <Compile Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**"/>
        <EmbeddedResource Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**"/>
        <None Remove=".godot/**;.idea/**;.vs/**;bin/**;obj/**"/>

        <AdditionalFiles Include="Vivhite/localization/**/*.json"/>

        <Compile Remove="Vivhite/**"/>
        <EmbeddedResource Remove="Vivhite/**"/>
        <None Include="Vivhite/**"/>
        <None Include="Vivhite.json"/>
        <None Include="project.godot"/>
        <None Include="export_presets.cfg"/>
        <None Include=".gitignore"/>
        <None Include="local.props.template"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="local.props" Condition="Exists('local.props')"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Vivhite\images\cards\"/>
        <Folder Include="Vivhite\images\characters\"/>
        <Folder Include="Vivhite\images\powers\"/>
        <Folder Include="Vivhite\images\relics\"/>
        <Folder Include="Vivhite\scenes\characters\"/>
    </ItemGroup>

    <Target Name="ValidateSts2GameInstall" BeforeTargets="ResolveAssemblyReferences">
        <Error Condition="!Exists('$(Sts2DataDir)\sts2.dll')" Text="Could not find sts2.dll under '$(Sts2DataDir)'. Copy local.props.template to local.props and set Sts2Dir/Sts2DataDir for your local game install."/>
    </Target>

    <Target Name="ValidateModDeploymentContract" BeforeTargets="PrepareForBuild;BeforeBuild;ValidateIroncladSkinAssets;Build;CopyMod;ExportPCK"
            Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Code="VIVH001"
               Condition="'$(CopyModOnBuild)' != 'false' and ('$(RunPckExport)' != 'true' or '$(STS2_SKIP_PCK_EXPORT)' == '1')"
               Text="Refusing split Vivhite deployment: explicit CopyModOnBuild=true requires RunPckExport=true and STS2_SKIP_PCK_EXPORT != 1 so Vivhite.pck, Vivhite.dll, and Vivhite.json are produced and deployed together. For a C#-only build, use /p:RunPckExport=false; CopyModOnBuild then defaults to false."/>
    </Target>

    <Target Name="ValidateIroncladSkinAssets" BeforeTargets="BeforeBuild"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(STS2_SKIP_PCK_EXPORT)' != '1'">
        <Error Condition="!Exists('$(IroncladSkinValidator)')"
               Text="Ironclad skin asset validator is missing: '$(IroncladSkinValidator)'."/>
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
              Command="&quot;$(PowerShellExe)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(IroncladSkinValidator)&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -Phase Source -GodotExe &quot;$(GodotExe)&quot; -Sts2Dir &quot;$(Sts2Dir)&quot; -RuntimeLayout &quot;$(IroncladSkinRuntimeLayout)&quot;"
              EnvironmentVariables="CopyModOnBuild=false"/>
    </Target>

    <Target Name="ExportPCK" DependsOnTargets="SyncManifestDependencies"
            Condition="'$(CopyModOnBuild)' != 'false' and '$(RunPckExport)' == 'true' and '$(STS2_SKIP_PCK_EXPORT)' != '1'">
        <Error Condition="'$(GodotExe)' == '' or !Exists('$(GodotExe)')" Text="GodotExe is required for PCK export. Copy local.props.template to local.props and set GodotExe, or build with /p:RunPckExport=false."/>
        <Error Condition="!Exists('$(GodotPckExporter)')" Text="Godot PCK export helper is missing: '$(GodotPckExporter)'."/>
        <Error Condition="!Exists('$(IroncladSkinValidator)')" Text="Ironclad skin asset validator is missing: '$(IroncladSkinValidator)'."/>
        <Error Condition="!Exists('$(TargetPath)')" Text="Compiled Vivhite assembly is missing: '$(TargetPath)'."/>
        <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
              Command="&quot;$(PowerShellExe)&quot; -NoProfile -ExecutionPolicy Bypass -File &quot;$(GodotPckExporter)&quot; -GodotExe &quot;$(GodotExe)&quot; -ProjectDir &quot;$(MSBuildProjectDirectory)&quot; -Preset &quot;$(GodotExportPreset)&quot; -OutputPath &quot;$(ModPckPath)&quot; -ValidatorPath &quot;$(IroncladSkinValidator)&quot; -AssemblyPath &quot;$(TargetPath)&quot; -ManifestPath &quot;$(MSBuildProjectDirectory)\$(MSBuildProjectName).json&quot; -ModOutputDir &quot;$(ModOutputDir)&quot; -RitsuLibVersion &quot;$(RitsuLibVersion)&quot; -IroncladSkinRuntimeLayout &quot;$(IroncladSkinRuntimeLayout)&quot; -PowerShellExe &quot;$(PowerShellExe)&quot; -DotnetRoot &quot;$(DOTNET_ROOT)&quot; -FailurePoint &quot;$(VivhiteDeploymentFailurePoint)&quot;"/>
    </Target>

    <!-- ExportPCK performs the complete directory transaction. CopyMod deliberately has
         no per-file Copy tasks, so the live triplet can never be torn by this project. -->
    <Target Name="CopyMod" AfterTargets="Build" DependsOnTargets="ValidateModDeploymentContract;ExportPCK"
            Condition="'$(CopyModOnBuild)' != 'false'">
        <Message Importance="High" Text="Vivhite deployment committed as one DLL/PCK/JSON directory batch: $(ModOutputDir)"/>
    </Target>

    <Target Name="SyncManifestDependencies"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(CopyModOnBuild)' != 'false'">
        <PropertyGroup>
            <RitsuLibVersion>$([System.IO.Path]::GetFileName('$(PkgSTS2_RitsuLib)'))</RitsuLibVersion>
        </PropertyGroup>
        <Error Condition="'$(PkgSTS2_RitsuLib)' == '' or '$(RitsuLibVersion)' == ''"
               Text="Could not resolve the installed STS2-RitsuLib package version for the Vivhite deployment candidate."/>
        <Message Importance="Low" Text="The deployment transaction will synchronize its candidate manifest to STS2-RitsuLib $(RitsuLibVersion); the source manifest and live directory are not modified during preparation."/>
    </Target>
</Project>
