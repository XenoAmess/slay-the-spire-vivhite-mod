  "sceneBindings": [
    {
      "scene": "scenes/combat.tscn",
      "skeletonData": "spine/combat/vivhite_combat_skeleton_data.tres",
      "requiredText": [
        "[node name=\"NIroncladVfx\" type=\"Node\" parent=\"Visuals\"]",
        "[node name=\"SlashVfxSlot\" type=\"SpineSlotNode\" parent=\"Visuals\"]",
        "slot_name = \"slash_mesh\"",
        "[node name=\"EyeSlot\" type=\"SpineSlotNode\" parent=\"Visuals\"]",
        "slot_name = \"eye_attach_slot\"",
        "[node name=\"EyeFire\" type=\"TextureRect\" parent=\"Visuals/EyeSlot\"]",
        "scale = Vector2(0.22, 0.28)",
        "[sub_resource type=\"Shader\" id=\"VivhiteMagicArcShader\"]",
        "uniform vec2 step = vec2(0.0, 0.02)",
        "float runtime_fade = 1.0 - clamp(step.x, 0.0, 1.0)",
        "base.a *= runtime_fade * clamp(master_step, 0.0, 1.0) * clamp(opacity, 0.0, 1.0)",
        "shader = SubResource(\"VivhiteMagicArcShader\")",
        "shader_parameter/ColorParameter = Color(1, 1, 1, 1)",
        "shader_parameter/OuterColor = Color(0.46, 0.1, 0.96, 1)",
        "shader_parameter/InnerColor = Color(0.32, 0.94, 1, 1)",
        "shader_parameter/step = Vector2(0, 0.02)",
        "shader_parameter/master_step = 1.0"
      ]
    },
    {
      "scene": "scenes/merchant.tscn",
      "skeletonData": "spine/merchant/merchant_skeleton_data.tres",
      "requiredText": [
        "[node name=\"SpineSprite\" type=\"SpineSprite\" parent=\".\"]",
        "preview_skin = \"default\"",
        "preview_animation = \"relaxed_loop\"",
        "scale = Vector2(0.28, 0.28)"
      ]
    },
    {
      "scene": "scenes/rest_site.tscn",
      "skeletonData": "spine/rest_site/rest_site_skeleton_data.tres"
    },
    {
      "scene": "scenes/character_select.tscn",
      "skeletonData": "spine/character_select/character_select_skeleton_data.tres"
    }
  ],
