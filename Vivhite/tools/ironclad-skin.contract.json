      "scene": "scenes/combat.tscn",
      "skeletonData": "spine/combat/vivhite_combat_skeleton_data.tres",
      "requiredText": [
        "[ext_resource type=\"Script\" path=\"res://Vivhite/skins/ironclad/scenes/vfx/vivhite_combat_vfx.gd\" id=\"4_vfx\"]",
        "[ext_resource type=\"Texture2D\" path=\"res://Vivhite/skins/ironclad/scenes/vfx/vivhite_eye_lens_glint.png\" id=\"5_eye_magic\"]",
        "[node name=\"VivhiteCombatVfx\" type=\"Node\" parent=\"Visuals\"]",
        "script = ExtResource(\"4_vfx\")",
        "[node name=\"SlashVfxSlot\" type=\"SpineSlotNode\" parent=\"Visuals\"]",
        "slot_name = \"slash_mesh\"",
        "[node name=\"EyeSlot\" type=\"SpineSlotNode\" parent=\"Visuals\"]",
        "slot_name = \"eye_attach_slot\"",
        "[node name=\"EyeMagic\" type=\"TextureRect\" parent=\"Visuals/EyeSlot\"]",
        "scale = Vector2(0.22, 0.28)",
        "mouse_filter = 2",
        "texture = ExtResource(\"5_eye_magic\")",
        "[sub_resource type=\"Shader\" id=\"VivhiteMagicArcShader\"]",
        "uniform vec2 step = vec2(0.0, 0.02)",
        "float runtime_fade = 1.0 - clamp(step.x, 0.0, 1.0)",
        "base.a *= runtime_fade * clamp(master_step, 0.0, 1.0) * clamp(opacity, 0.0, 1.0)",
        "shader = SubResource(\"VivhiteMagicArcShader\")",
        "shader_parameter/ColorParameter = Color(1, 1, 1, 1)",
        "shader_parameter/step = Vector2(0, 0.02)",
        "shader_parameter/master_step = 1.0"
      ],
